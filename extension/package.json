{
  "name": "python-semantic-highlighter",
  "displayName": "Python Semantic Highlighter",
  "description": "Semantic highlighting for Python inspired by IntelliJ",
  "version": "0.2.0",
  "publisher": "proboscis",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pythonSemanticHighlighter.refresh",
        "title": "Refresh Semantic Highlighting",
        "category": "Python Semantic Highlighter"
      },
      {
        "command": "pythonSemanticHighlighter.toggle",
        "title": "Toggle Semantic Highlighting",
        "category": "Python Semantic Highlighter"
      },
      {
        "command": "pythonSemanticHighlighter.openSettings",
        "title": "Open Settings Panel",
        "category": "Python Semantic Highlighter"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Python Semantic Highlighter",
      "properties": {
        "pythonSemanticHighlighter.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Python semantic highlighter."
        },
        "pythonSemanticHighlighter.debounceMs": {
          "type": "number",
          "default": 150,
          "description": "Delay in milliseconds before re-running the highlighter after edits."
        },
        "pythonSemanticHighlighter.semanticCategories": {
          "type": "object",
          "description": "Semantic categories with random color allocation based on symbol name hash. Each category can be enabled/disabled and have HSV range configured.",
          "default": {
            "localVariable": {
              "enabled": true,
              "hueRange": [180, 270],
              "saturation": [40, 60],
              "lightness": [55, 70]
            },
            "globalVariable": {
              "enabled": true,
              "hueRange": [270, 360],
              "saturation": [40, 60],
              "lightness": [55, 70]
            },
            "parameter": {
              "enabled": true,
              "hueRange": [90, 150],
              "saturation": [45, 65],
              "lightness": [55, 70]
            },
            "functionDef": {
              "enabled": true,
              "hueRange": [30, 60],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "functionCall": {
              "enabled": true,
              "hueRange": [30, 60],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "methodCall": {
              "enabled": true,
              "hueRange": [0, 30],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "classDef": {
              "enabled": true,
              "hueRange": [45, 75],
              "saturation": [55, 75],
              "lightness": [55, 70]
            },
            "classReference": {
              "enabled": true,
              "hueRange": [45, 75],
              "saturation": [55, 75],
              "lightness": [55, 70]
            },
            "attribute": {
              "enabled": true,
              "hueRange": [150, 210],
              "saturation": [40, 55],
              "lightness": [55, 70]
            },
            "typeAnnotation": {
              "enabled": false,
              "hueRange": [280, 320],
              "saturation": [35, 50],
              "lightness": [60, 75]
            },
            "decorator": {
              "enabled": true,
              "hueRange": [50, 70],
              "saturation": [60, 80],
              "lightness": [50, 65]
            },
            "self": {
              "enabled": true,
              "hueRange": [290, 310],
              "saturation": [50, 70],
              "lightness": [50, 65]
            },
            "builtin": {
              "enabled": true,
              "hueRange": [220, 260],
              "saturation": [40, 60],
              "lightness": [55, 70]
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable semantic coloring for this category"
              },
              "hueRange": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Hue range [min, max] (0-360)"
              },
              "saturation": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Saturation range [min, max] (0-100)"
              },
              "lightness": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Lightness range [min, max] (0-100)"
              }
            }
          }
        },
        "pythonSemanticHighlighter.keywordColors": {
          "type": "object",
          "description": "Fixed colors for specific Python keywords.",
          "default": {
            "def": "#CC7832",
            "class": "#CC7832",
            "return": "#CC7832",
            "yield": "#CC7832",
            "await": "#CC7832",
            "async": "#CC7832",
            "if": "#CC7832",
            "elif": "#CC7832",
            "else": "#CC7832",
            "for": "#CC7832",
            "while": "#CC7832",
            "break": "#CC7832",
            "continue": "#CC7832",
            "try": "#CC7832",
            "except": "#CC7832",
            "finally": "#CC7832",
            "raise": "#CC7832",
            "with": "#CC7832",
            "as": "#CC7832",
            "import": "#CC7832",
            "from": "#CC7832",
            "pass": "#CC7832",
            "lambda": "#CC7832",
            "global": "#CC7832",
            "nonlocal": "#CC7832",
            "assert": "#CC7832",
            "del": "#CC7832",
            "in": "#CC7832",
            "is": "#CC7832",
            "not": "#CC7832",
            "and": "#CC7832",
            "or": "#CC7832",
            "match": "#CC7832",
            "case": "#CC7832",
            "type": "#CC7832"
          },
          "additionalProperties": {
            "type": "string",
            "description": "Hex color value for this keyword"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint . --ext ts",
    "package": "vsce package --allow-missing-repository",
    "test": "echo \"No tests yet\"",
    "build:rust": "cargo build --release --manifest-path ../rust-highlighter/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {}
}
