{
  "name": "python-semantic-highlighter",
  "displayName": "Python Semantic Highlighter",
  "description": "Semantic highlighting for Python inspired by IntelliJ",
  "version": "0.5.1",
  "publisher": "proboscis",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pythonSemanticHighlighter.refresh",
        "title": "Refresh Semantic Highlighting",
        "category": "Python Semantic Highlighter"
      },
      {
        "command": "pythonSemanticHighlighter.toggle",
        "title": "Toggle Semantic Highlighting",
        "category": "Python Semantic Highlighter"
      },
      {
        "command": "pythonSemanticHighlighter.openSettings",
        "title": "Open Settings Panel",
        "category": "Python Semantic Highlighter"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Python Semantic Highlighter",
      "properties": {
        "pythonSemanticHighlighter.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Python semantic highlighter."
        },
        "pythonSemanticHighlighter.debounceMs": {
          "type": "number",
          "default": 150,
          "description": "Delay in milliseconds before re-running the highlighter after edits."
        },
        "pythonSemanticHighlighter.semanticCategories": {
          "type": "object",
          "markdownDescription": "Semantic categories with random color allocation based on symbol name hash.\n\n**Use the visual settings panel:** `Cmd+Shift+P` → `Python Semantic Highlighter: Open Settings Panel`\n\n**Example:**\n```json\n{\n  \"localVariable\": {\n    \"enabled\": true,\n    \"hueRange\": [180, 270],\n    \"saturation\": [40, 60],\n    \"lightness\": [55, 70]\n  }\n}\n```\n\n**Categories:** `localVariable`, `globalVariable`, `parameter`, `functionDef`, `functionCall`, `methodCall`, `classDef`, `classReference`, `attribute`, `typeAnnotation`, `decorator`, `self`, `builtin`",
          "default": {
            "localVariable": {
              "enabled": true,
              "hueRange": [180, 270],
              "saturation": [40, 60],
              "lightness": [55, 70]
            },
            "globalVariable": {
              "enabled": true,
              "hueRange": [270, 360],
              "saturation": [40, 60],
              "lightness": [55, 70]
            },
            "parameter": {
              "enabled": true,
              "hueRange": [90, 150],
              "saturation": [45, 65],
              "lightness": [55, 70]
            },
            "functionDef": {
              "enabled": true,
              "hueRange": [30, 60],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "functionCall": {
              "enabled": true,
              "hueRange": [30, 60],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "methodCall": {
              "enabled": true,
              "hueRange": [0, 30],
              "saturation": [50, 70],
              "lightness": [55, 70]
            },
            "classDef": {
              "enabled": true,
              "hueRange": [45, 75],
              "saturation": [55, 75],
              "lightness": [55, 70]
            },
            "classReference": {
              "enabled": true,
              "hueRange": [45, 75],
              "saturation": [55, 75],
              "lightness": [55, 70]
            },
            "attribute": {
              "enabled": true,
              "hueRange": [150, 210],
              "saturation": [40, 55],
              "lightness": [55, 70]
            },
            "typeAnnotation": {
              "enabled": false,
              "hueRange": [280, 320],
              "saturation": [35, 50],
              "lightness": [60, 75]
            },
            "decorator": {
              "enabled": true,
              "hueRange": [50, 70],
              "saturation": [60, 80],
              "lightness": [50, 65]
            },
            "self": {
              "enabled": true,
              "hueRange": [290, 310],
              "saturation": [50, 70],
              "lightness": [50, 65]
            },
            "builtin": {
              "enabled": true,
              "hueRange": [220, 260],
              "saturation": [40, 60],
              "lightness": [55, 70]
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable semantic coloring for this category"
              },
              "hueRange": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Hue range [min, max] (0-360)"
              },
              "saturation": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Saturation range [min, max] (0-100)"
              },
              "lightness": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "Lightness range [min, max] (0-100)"
              }
            }
          }
        },
        "pythonSemanticHighlighter.keywordColors": {
          "type": "object",
          "markdownDescription": "Fixed colors for specific Python keywords. Empty/unset means use IDE theme default.\n\n**Use the visual settings panel:** `Cmd+Shift+P` → `Python Semantic Highlighter: Open Settings Panel`\n\n**Example:**\n```json\n{\n  \"def\": \"#CC7832\",\n  \"return\": \"#CC7832\",\n  \"yield\": \"#B58900\"\n}\n```\n\n**Keywords:** `def`, `class`, `return`, `yield`, `await`, `async`, `if`, `elif`, `else`, `for`, `while`, `try`, `except`, `import`, `from`, etc.",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "description": "Hex color value for this keyword (empty = use theme default)"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint . --ext ts",
    "package": "vsce package --allow-missing-repository",
    "test": "echo \"No tests yet\"",
    "build:rust": "cargo build --release --manifest-path ../rust-highlighter/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {}
}
